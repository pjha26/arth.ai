# PostgreSQL with pgvector. DIRECT_URL must bypass any transaction pooler for migrations.
DATABASE_URL=
DIRECT_URL=

# Same Redis instance for web producer, worker, and REST rate limits.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Same signing secret on web and worker; generate randomly. Never use these as NEXT_PUBLIC variables.
AUTH_SECRET=
STAFF_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000

GEMINI_API_KEY=
GROQ_API_KEY=
REPORT_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=gemini-embedding-001

# local is development-only. Free hosted PDFs use a private Supabase bucket.
REPORT_STORAGE=local
# Set true on both web and worker to enable supervised pilot limits.
FREE_PILOT_MODE=false
# Enable after applying the catalogue migration. Disabled by default.
ENABLE_CSV_CATALOGUE=false
# Pilot request ceilings. Set below the actual free account limits. Zero disables a provider.
GEMINI_PILOT_REQUESTS_PER_MINUTE=6
GEMINI_PILOT_REQUESTS_PER_DAY=40
GROQ_PILOT_REQUESTS_PER_MINUTE=6
GROQ_PILOT_REQUESTS_PER_DAY=40
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=arthai-reports
# Historical drive: artifacts still need these credentials when downloaded.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# disabled provides dashboard downloads without email or follow-ups.
# Set enabled only with a verified sender and configured Resend credentials.
EMAIL_DELIVERY=disabled
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
SLACK_WEBHOOK_URL=
GOOGLE_PLACES_API_KEY=

ENABLE_INTENT_SCORING=false
ML_SERVICE_URL=http://localhost:8001
ENABLE_VISUAL_ANALYSIS=false

# Optional account/model rate card for USD estimates, keyed by provider:model.
# Example shape: {"google:MODEL_ID":{"inputPerMillionUSD":0.0,"outputPerMillionUSD":0.0}}
# Leave empty until you have verified the rates for your account. Unknown is not zero.
AI_MODEL_PRICES=
