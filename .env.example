# PostgreSQL with pgvector. DIRECT_URL must bypass any transaction pooler for migrations.
DATABASE_URL=
DIRECT_URL=

# Same Redis instance for web producer, worker, and REST rate limits.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Same signing secret on web and worker; generate randomly. Never use these as NEXT_PUBLIC variables.
AUTH_SECRET=
STAFF_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000

GEMINI_API_KEY=
GROQ_API_KEY=
REPORT_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=gemini-embedding-001

# local is development-only. Use drive and private shared-drive credentials in production.
REPORT_STORAGE=local
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
SLACK_WEBHOOK_URL=
GOOGLE_PLACES_API_KEY=

ENABLE_INTENT_SCORING=false
ML_SERVICE_URL=http://localhost:8001
ENABLE_VISUAL_ANALYSIS=false
