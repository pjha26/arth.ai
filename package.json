{
  "name": "arth.ai",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm --prefix worker run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "node --test tests/core.test.mjs tests/pipeline.test.mjs tests/delivery.test.mjs tests/followups.test.mjs tests/staging-safety.test.mjs tests/research-cache.test.mjs tests/intent.test.mjs tests/operations.test.mjs tests/readiness.test.mjs tests/status.test.mjs tests/delivery-events.test.mjs tests/report-quality.test.mjs tests/report-quality-pilot.test.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "dev:web": "next dev",
    "test:ml": "node scripts/ml.mjs test",
    "test:artifacts": "node --test tests/artifact-flow.test.mjs",
    "dev:ml": "node scripts/ml.mjs serve",
    "staging:init": "node scripts/staging-init.mjs",
    "staging:migrate": "node --env-file=.env.staging scripts/staging-migrate.mjs",
    "test:staging": "node scripts/staging-test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check:live": "node scripts/release-check.mjs --live",
    "test:migrations": "node --env-file=.env.staging tests/staging-migrations.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/react": "^3.0.193",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.191",
    "axios": "^1.16.1",
    "bullmq": "^5.76.9",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "puppeteer": "^25.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "overrides": {
    "googleapis-common": { "gaxios": "^7.3.1" },
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" }
  }
}
