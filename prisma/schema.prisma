// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Company {
  id              String      @id @default(uuid())
  domain          String      @unique
  website         String?
  name            String
  industry        String?
  size            String?
  techStack       Json?       // ["React", "Node", "AWS"]
  fundingStage    String?
  lastAuditedAt   DateTime?
  auditCount      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  leads           Lead[]
  reports         Report[]
  signals         Signal[]
  embeddings      Embedding[]
}

model Signal {
  id          String   @id @default(uuid())
  companyId   String
  type        String   // "hiring_spike", "funding", "leadership_change"
  detectedAt  DateTime @default(now())
  data        Json
  severity    String   // "high", "medium", "low"
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Lead {
  id                String   @id @default(uuid())
  companyId         String
  fullName          String?
  email             String?
  source            String   @default("manual") // manual | auto_discovered
  salesStatus       String   @default("new")
  painPoints        String
  challengeTags     String[] @default([])
  personaType       String   @default("general")
  outreachConsent   Boolean  @default(false)
  intentProbability Float?
  legacyIntentProbability Float?
  intentModel       String?
  intentScoredAt    DateTime?
  intentStatus      String @default("unknown")
  intentAlertedAt   DateTime?
  unsubscribed      Boolean  @default(false)
  lastFollowUpSentAt DateTime?
  followUpStage     Int      @default(0)
  createdAt         DateTime @default(now())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reports           Report[]
}

model Report {
  id            String   @id @default(uuid())
  companyId     String
  leadId        String?
  requestKey    String? @unique
  requestFingerprint String?
  lead          Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  personaType   String   @default("general") // "founder", "cto", "marketer"
  legacyScore   Int?
  score         Int?     // AI quality score 0-100
  insights      Json?    // structured AI output
  deltaInsights Json?    // diff from previous report
  pdfUrl        String?
  verificationStatus String @default("unverified")
  artifactStatus String @default("pending")
  deliveryStatus String @default("pending")
  deliveryError String?
  providerMessageId String?
  deliveryStartedAt DateTime?
  generationAttempt Int @default(1)
  freshResearch Boolean @default(false)
  errorMessage  String?
  dispatchedAt DateTime?
  
  // Mirror fields used by the frontend while processing
  logo          String?  
  description   String?
  aiSummary     String?
  
  status        String   @default("pending") // pending | processing | done | failed
  chatEnabled   Boolean  @default(false)
  generatedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  chatMessages  ChatMessage[]
  sources       ReportSource[]
  events        ReportEvent[]
  followUps     FollowUp[]
  @@index([status, dispatchedAt])
  @@index([leadId, createdAt])
}

model FollowUp {
  id String @id @default(uuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  stage Int
  dueAt DateTime
  status String @default("pending") // pending | sending | accepted | skipped | uncertain
  startedAt DateTime?
  providerMessageId String?
  errorMessage String?
  @@unique([reportId, stage])
  @@index([status, dueAt])
  @@index([status, startedAt])
}

model ReportSource {
  id String @id
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url String
  title String
  excerpt String
  retrievedAt DateTime
  publishedAt DateTime?
  @@index([reportId])
}

model ReportEvent {
  id String @id @default(uuid())
  reportId String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type String
  actor String
  createdAt DateTime @default(now())
  @@index([reportId, type])
  @@index([createdAt, type])
}

model ChatMessage {
  id        String   @id @default(uuid())
  reportId  String
  role      String   // "user" or "assistant"
  actor     String @default("legacy")
  content   String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  stage     String   // enrich | ai_report | pdf | email
  status    String   // running | done | failed
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Embedding {
  id          String   @id @default(uuid())
  companyId   String
  reportId    String?
  chunk       String
  embedding   Unsupported("vector(768)")?
  metadata    Json?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([reportId])
}

model IndustryBenchmark {
  id          String   @id @default(uuid())
  industry    String
  metric      String   // "avg_tech_stack_size", "avg_team_size"
  value       Float
  sampleSize  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model DiscoverySearch {
  id          String   @id @default(cuid())
  industry    String
  region      String
  sizeMin     Int?
  sizeMax     Int?
  signal      String?
  status      String   @default("pending") // pending | processing | completed | failed
  createdAt   DateTime @default(now())
  companies   DiscoveredCompany[]
}

model DiscoveredCompany {
  id                    String   @id @default(cuid())
  searchId              String
  search                DiscoverySearch @relation(fields: [searchId], references: [id])
  companyId             String?
  name                  String
  domain                String?
  source                String   // "google_places" | "web_search"

  websiteLive           Boolean?
  sourcesCorroborating  Int      @default(0)
  confidenceTier        String   @default("unconfirmed") // verified | likely | unconfirmed
  verificationSignals   Json?

  fitScore              Float?
  fitReasons            Json?

  status                String   @default("discovered") // discovered | filtered_out | queued | researched
  rank                  Int?
  createdAt             DateTime @default(now())
}

model LeadOutcome {
  id                    String   @id @default(cuid())
  discoveredCompanyId   String
  outcome               String   // contacted | engaged | converted | rejected
  updatedAt             DateTime @updatedAt
}
